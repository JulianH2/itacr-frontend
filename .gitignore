# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log*
yarn-error.log

# Environment files (keep only the example)
.env
.env.*
!.env.example

# Test and coverage output
/coverage
__screenshots__/

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Angular and tooling caches
/.angular/cache
.sass-cache/
/connect.lock
/libpeerconnection.log
testem.log
/typings
.eslintcache

# AI assistant files: local only, never committed
CLAUDE.md
CLAUDE.local.md
.claude/
AGENTS.md
GEMINI.md
.cursor/
.cursorrules
.windsurfrules
.github/copilot-instructions.md
.vscode/mcp.json

# System files
.DS_Store
Thumbs.db
desktop.ini
