# Reference only: Angular does not read .env files at runtime.
# The real values live in src/environments/environment*.ts and are bundled at build time.
# Keep this file in sync with the AppEnvironment interface (src/environments/environment.model.ts).
# Never put secrets here: everything in a frontend bundle is public.

# Base URL of the ITACR REST API (itacr-backend)
API_BASE_URL=http://localhost:3000/api/v1

# Socket.IO server used by the Kitchen Display System
SOCKET_URL=http://localhost:3000

# Public VAPID key for Web Push subscriptions (the private key stays in itacr-backend)
VAPID_PUBLIC_KEY=
