{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "cacheVersion": 2
  },
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "catalog-product-images",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/images/products/**"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    },
    {
      "name": "fonts",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "catalog-api",
      "version": 1,
      "urls": ["/api/v1/products**", "/api/v1/categories**", "/api/v1/combos**"],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "3s",
        "maxAge": "1d",
        "maxSize": 200
      }
    },
    {
      "name": "product-images",
      "version": 1,
      "urls": ["/uploads/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxAge": "7d",
        "maxSize": 300
      }
    },
    {
      "name": "dining-tables",
      "version": 1,
      "urls": ["/api/v1/dining-tables", "https://*.azurewebsites.net/api/v1/dining-tables"],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "3s",
        "maxAge": "7d",
        "maxSize": 1
      }
    },
    {
      "name": "catalog-api-v2",
      "version": 1,
      "urls": ["/api/v1/catalog/**", "https://*.azurewebsites.net/api/v1/catalog/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "3s",
        "maxAge": "1d",
        "maxSize": 100
      }
    }
  ]
}
